# Where the landing page points its download buttons. Defaults to the repo's
# GitHub releases; set this to a mirror or a fork's releases if needed.
PUBLIC_RELEASE_BASE=https://github.com/jrny6996/claude-business/releases/latest/download

# Version shown on the page and used to build artifact filenames. Keep this in
# step with apps/desktop/package.json when you cut a release.
PUBLIC_APP_VERSION=0.1.0

# ─────────────────────────────────────────────────────────────────────────────
# Hosted licensing and backup service
#
# This deployment carries the marketing site AND the only server-side code in
# the product (apps/landing/src/pages/api/[...path].ts -> @repo/cloud). Every
# value below is a secret and belongs in the host's environment-variable UI,
# never in the repo. With none of them set the marketing site still builds and
# serves; only the paid features are unavailable.
# ─────────────────────────────────────────────────────────────────────────────

# Our own Stripe account — for selling premium. This is NOT a user's BYOK key;
# no user key is ever handled server-side.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The Stripe Price premium is sold at. The price itself lives in Stripe, not in
# this codebase, so it can change without a deploy — and so nobody has to guess
# a number here while that decision is open.
PREMIUM_PRICE_ID=

# The licence issuer's Ed25519 key pair.
#
# The PRIVATE half exists ONLY here. It is the one thing that can mint a
# licence; nothing on a user's machine can. Generate a pair with:
#   node scripts/issue-license.mjs --generate-keypair
# Paste with literal \n escapes — most hosts can't store real newlines.
DSV_LICENSE_PRIVATE_KEY=
DSV_LICENSE_PUBLIC_KEY=

# Canonical origin, used for Stripe's return URLs. Netlify sets URL itself.
SITE_URL=

# Licence delivery. With no provider configured, keys are still shown on the
# purchase page and recoverable — delivery failures are logged, not hidden.
RESEND_API_KEY=
LICENSE_FROM_EMAIL=Store Validator <licences@example.com>

# Hosted backup limits. The upload cap must stay under the platform's own
# request-body limit — Netlify's synchronous functions stop at 6MB.
BACKUP_MAX_UPLOAD_BYTES=5242880
BACKUP_QUOTA_BYTES=262144000
BACKUP_MAX_COUNT=10
